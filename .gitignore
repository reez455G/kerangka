.env
__pycache__/
*.pyc
.venv/
# .omp/skills/ is the authoritative Git-tracked skill source (program.md §17).
# Distributed to devices via R2/rclone (publish-skills.sh); never gitignored.
# Per-fork/per-device list of skill names to keep OUT of the shared Git repo
# and OUT of R2 publish — see private-skills.txt.example and program.md §18.
private-skills.txt

# Real infra config — never commit; use the .example templates instead
cloudflare/my-ai-agents-gateway/wrangler.toml
registry/resources.json

# Fossil repository database file (PRIVATE) — physically colocated here for
# convenience, never git-tracked. The old checkout at ~/my-ai-agents was
# deleted 2026-08-23 after all content was committed to Fossil. A new checkout
# can be opened anytime with: fossil open ~/kerangka/my-ai-agents.fossil <dir>
# Distributing this file to another device is NOT done via git — use scp or
# a Fossil server (README.md "Kredensial R2" section).
my-ai-agents.fossil

# Full git-history mirror of the old private "my-ai-agents-archived" GitHub
# repo (67 commits, all blobs) — bundled with `git bundle create --all`
# before deletion so nothing from that history is lost. Never git-tracked:
# same rule as my-ai-agents.fossil above, gitignored content never leaves
# this machine through git. Restore anytime with:
#   git clone my-ai-agents-archived.bundle <dest>
# One already-dead secret exists in this history (.env.keys, a dotenvx key
# removed by the user's own commit "Remove committed .env.keys (dead
# dotenvx key)") — not an active credential, kept only for historical
# completeness. See program.md §22 / control-plane.md Decision 18.
my-ai-agents-archived.bundle
