# LLM Provider untuk Hindsight (Ollama lokal — tidak perlu API key)
HINDSIGHT_API_LLM_PROVIDER=ollama
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_BASE_URL=http://host.docker.internal:11434
HINDSIGHT_API_LLM_MODEL=gpt-oss:120b

# Endpoint Hindsight API yang dipakai kode Python kamu
HINDSIGHT_API_URL=http://localhost:8890

# Worker identity stabil, wajib untuk deployment 24/7
HINDSIGHT_API_WORKER_ID=hindsight-prod

# Token autentikasi Hindsight API (wajib untuk akses lintas device via Tailscale)
# Generate dengan: openssl rand -hex 32
HINDSIGHT_API_TOKEN=ganti-dengan-token-rahasia-yang-panjang

# Bank memori utama (samakan di semua device — satu bank yang sama dipakai
# lintas otak/device; dipakai omp-config.template.yml dan verify.sh)
HINDSIGHT_BANK_ID=my-ai-agent

# Agent Control Plane — my-ai-agents-gateway Worker
# URL: your deployed my-ai-agents-gateway Worker URL
MAI_GATEWAY_URL=https://my-ai-agents-gateway.<your-subdomain>.workers.dev
# Token untuk API gateway — harus cocok dengan Worker Secret GATEWAY_TOKEN
# Ambil dari operator yang menjalankan: wrangler secret put GATEWAY_TOKEN
# Atau dari ~/.omp/agent/.env di device yang sudah di-setup
MAI_GATEWAY_TOKEN=ganti-dengan-gateway-token-rahasia

# Sync .omp/skills/ via Cloudflare R2 (rclone), menggantikan Syncthing — program.md §16
# Kredensial S3-compatible R2 — minta ke operator, atau lihat program.md §16 untuk cara membuatnya
R2_SKILLS_ACCESS_KEY_ID=ganti-dengan-r2-access-key-id
R2_SKILLS_SECRET_ACCESS_KEY=ganti-dengan-r2-secret-access-key
R2_SKILLS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# Path R2 tempat .omp/skills/ di-mirror (bucket/prefix) — dipakai rclone-sync-skills.sh
R2_SKILLS_REMOTE_PATH=<bucket-name>/my-ai-agents/omp-skills

# Sync ~/private-backup/ (Fossil DB, archive bundle, secrets copy — apapun yang
# TIDAK boleh hidup di dalam direktori project yang bisa kena `rm -rf`) via R2.
# SEPARATE prefix dari R2_SKILLS_REMOTE_PATH — jangan pernah campur skill yang
# didistribusikan multi-device dengan backup privat single-device di path yang sama.
# Dipakai rclone-sync-private.sh. Kredensial R2 sama dengan R2_SKILLS_* di atas.
R2_PRIVATE_REMOTE_PATH=<bucket-name>/my-ai-agents/private-backup
